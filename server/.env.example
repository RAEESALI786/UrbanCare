# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/urbancare

# Frontend origin allowed to call this API (Vite dev server)
CLIENT_URL=http://localhost:5174

# Professional portal origin (the pro-client app) - also allowed to call this API
PRO_CLIENT_URL=http://localhost:5173

PORT=5000

# Firebase Admin credentials — from Firebase Console > Project settings >
# Service accounts > Generate new private key (downloads a JSON file).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the JSON file, keeping the \n escapes as-is.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Gemini API key for the chat/booking assistant — free tier, no card
# required. Get one at https://aistudio.google.com (click "Get API key").
GEMINI_API_KEY=
